# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bossjob_ethiopia
DB_USER=postgres
DB_PASSWORD=postgres

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=7d
JWT_REFRESH_EXPIRY=30d

# Fayda National ID Integration
FAYDA_API_URL=https://api.fayda.gov.et
FAYDA_API_KEY=your-fayda-api-key
FAYDA_API_SECRET=your-fayda-api-secret

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHANNEL_ID=@bossjob_ethiopia

# Telebirr Payment Integration
TELEBIRR_APP_ID=your-telebirr-app-id
TELEBIRR_APP_KEY=your-telebirr-app-key
TELEBIRR_API_URL=https://api.telebirr.com
TELEBIRR_PUBLIC_KEY=your-telebirr-public-key

# Chapa Payment Integration
CHAPA_API_KEY=your-chapa-api-key
CHAPA_API_URL=https://api.chapa.co/v1

# SMS Gateway (Ethio Telecom)
SMS_API_URL=https://sms.ethiotelecom.et
SMS_API_KEY=your-sms-api-key
SMS_SENDER_ID=BOSSJOB

# AWS S3 (or compatible storage)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=af-south-1
AWS_BUCKET_NAME=bossjob-ethiopia

# Security
ENCRYPTION_KEY=your-32-character-encryption-key
BCRYPT_SALT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-password
